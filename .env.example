# Copy this file to .env and fill in your key. Never commit .env.

GEMINI_API_KEY=your-key-here

# A Flash model is much faster than Pro for Q&A over notes.
# Use the exact model names listed in Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash
# Tried automatically when the main model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# 0 = no "thinking" on Flash models (fastest). Remove this line if you use a Pro model.
GEMINI_THINKING_BUDGET=0

LLM_TIMEOUT_SECONDS=30
SUMMARY_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=2

# true = may add a clearly labeled "Beyond your notes:" section
# false = strictly answers from your notes only
ALLOW_GENERAL_KNOWLEDGE=true
